{
  "name": "estudio-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "pnpm run dev:web",
    "build": "pnpm run build:web",
    "start": "pnpm run start:web",

    "dev:web": "pnpm --filter estudio dev",
    "dev:web:api": "pnpm --filter estudio dev:api",
    "dev:web:worker": "pnpm --filter estudio dev:worker",

    "build:web": "pnpm --filter estudio build",
    "start:web": "pnpm --filter estudio start",
    "start:web:worker": "pnpm --filter estudio start:worker",
    "start:web:all": "pnpm --filter estudio start:all",

    "dev:captions-api": "cd apps/captions-api && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8010",
    "build:captions-api": "cd apps/captions-api && uv sync --no-dev",
    "start:captions-api": "cd apps/captions-api && uv run uvicorn app.main:app --host 0.0.0.0 --port 8010",

    "lint:web": "pnpm --filter estudio lint",
    "typecheck:web": "pnpm --filter estudio exec tsc --noEmit",

    "lint": "pnpm run lint:web",
    "typecheck": "pnpm run typecheck:web"
  }
}
