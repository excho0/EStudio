# ------------------------------------------------------------
# Core app/auth
# ------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
CONTENT_ASSET_SIGNING_SECRET=

# HTTP server port
PORT=3000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Driver resolution:
# - sqlite (default local)
# - postgres
DB_DRIVER=sqlite

# SQLite (default local file DB)
SQLITE_URL=file:./data/app.db

# Postgres (production / multi-instance)
POSTGRES_URL=
DATABASE_URL=

# Drizzle production migrations fallback
DATABASE_PROD_MIGRATIONS_URL=

# ------------------------------------------------------------
# OAuth providers (optional)
# ------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ------------------------------------------------------------
# SMTP / email provider (optional)
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false

# ------------------------------------------------------------
# Redis and queue topology
# ------------------------------------------------------------
# Shared Redis fallback
REDIS_URL=

# Queue-specific Redis endpoints (optional overrides)
RENDER_QUEUE_REDIS_URL=
PUBLISH_QUEUE_REDIS_URL=

# Queue toggles
RENDER_QUEUE_ENABLED=true
PUBLISH_QUEUE_ENABLED=true

# Worker concurrency
RENDER_WORKER_CONCURRENCY=1
PUBLISH_WORKER_CONCURRENCY=2

# Optional secret for internal queue health route
RENDER_WORKER_SECRET=

# ------------------------------------------------------------
# Realtime / event bus Redis routing (optional overrides)
# ------------------------------------------------------------
SOCKET_IO_REDIS_URL=
REALTIME_REDIS_URL=
EVENT_BUS_REDIS_URL=

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
# local (default) | s3
STORAGE_DRIVER=local

# Used by local driver
STORAGE_BASE_DIR=./data

# S3/MinIO storage adapter (used when STORAGE_DRIVER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PREFIX=
STORAGE_S3_PUBLIC_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_SESSION_TOKEN=

# ------------------------------------------------------------
# Render backend selection
# ------------------------------------------------------------
# local (default) | lambda
RENDER_BACKEND=local

# Optional explicit asset origin used by render paths
RENDER_ASSET_BASE_URL=

# ------------------------------------------------------------
# Remotion Lambda backend (direct @remotion/lambda-client mode)
# ------------------------------------------------------------
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_REGION=
REMOTION_LAMBDA_SERVE_URL=

# Optional lambda tuning
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_POLL_MS=3000
REMOTION_LAMBDA_TIMEOUT_MS=3600000

# Optional lambda dispatch fallback endpoint
# Used when direct lambda variables above are not set.
RENDER_LAMBDA_DISPATCH_URL=

# ------------------------------------------------------------
# Local Remotion render tuning
# ------------------------------------------------------------
# Optional integer or percent string (example: "6" or "70%")
REMOTION_RENDER_CONCURRENCY=

# Optional integer, controls offthread video decoding workers
REMOTION_OFFTHREAD_VIDEO_THREADS=

# Optional browser executable overrides
REMOTION_RENDER_BROWSER_EXECUTABLE=
REMOTION_BROWSER_EXECUTABLE=

# chrome-for-testing (default) | headless-shell
REMOTION_RENDER_CHROME_MODE=chrome-for-testing

# Optional ffmpeg path override for mux/concat operations
REMOTION_FFMPEG_PATH=

# Log ffmpeg invocations in render pipeline
REMOTION_LOG_FFMPEG=false

# Enable non-headless debug mode for render browser (local debugging)
REMOTION_RENDER_DEBUG_NON_HEADLESS=false

# ------------------------------------------------------------
# Multi-render tuning (advanced local render strategy)
# ------------------------------------------------------------
REMOTION_MULTI_RENDER=false
REMOTION_MULTI_RENDER_INSTANCES=
REMOTION_MULTI_RENDER_CHUNK_SIZE=
REMOTION_MULTI_RENDER_MAX_FRAMES_PER_BROWSER=
REMOTION_MULTI_RENDER_PER_BROWSER_CONCURRENCY=

# ------------------------------------------------------------
# Shader/headless GL options
# ------------------------------------------------------------
REMOTION_RENDER_ENABLE_SHADER=false

# Optional GL backend when shader rendering is enabled:
# angle | egl | swiftshader | swangle
REMOTION_RENDER_GL=

# Shader debug mode:
# none | passthrough | uv | solid
REMOTION_RENDER_SHADER_DEBUG_MODE=none

# ------------------------------------------------------------
# Render/publish state recovery and stores
# ------------------------------------------------------------
# Marks rendering content failed if stale beyond threshold (ms)
RENDER_STALE_TIMEOUT_MS=120000

# Marks queued/publishing publishes failed if stale beyond threshold (ms)
PUBLISH_STALE_TIMEOUT_MS=180000

# Render progress snapshot store:
# memory | redis (redis auto-used in prod when REDIS_URL exists)
RENDER_PROGRESS_STORE=

# ------------------------------------------------------------
# Asset API cache tuning
# ------------------------------------------------------------
ASSET_MEMORY_CACHE_MAX_MB=128
ASSET_METADATA_CACHE_TTL_MS=5000

# ------------------------------------------------------------
# Runtime/debug simulation flags (optional)
# ------------------------------------------------------------
MOCK_FAN_SPEED=false
RENDER_SIMULATE=false
RENDER_SIMULATE_ID=demo-render

# ------------------------------------------------------------
# Platform/runtime helpers (optional)
# ------------------------------------------------------------
# Used by auth email URL resolver in hosted environments
VERCEL_URL=
