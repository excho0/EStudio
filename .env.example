# ------------------------------------------------------------
# Core app/auth
# ------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
CONTENT_ASSET_SIGNING_SECRET=

# HTTP server port
PORT=3000

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
# Pretty logs in development (single-line JSON when false)
LOG_PRETTY=true

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Driver resolution:
# - sqlite (default local)
# - postgres
DB_DRIVER=sqlite

# SQLite (default local file DB)
SQLITE_URL=file:./data/app.db

# Postgres (production / multi-instance)
POSTGRES_URL=
DATABASE_URL=

# Drizzle production migrations fallback
DATABASE_PROD_MIGRATIONS_URL=

# ------------------------------------------------------------
# OAuth providers (optional)
# ------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ------------------------------------------------------------
# SMTP / email provider (optional)
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false

# ------------------------------------------------------------
# Redis and queue topology
# ------------------------------------------------------------
# Shared Redis fallback
REDIS_URL=

# Queue-specific Redis endpoints (optional overrides)
RENDER_QUEUE_REDIS_URL=
PUBLISH_QUEUE_REDIS_URL=
CAPTION_QUEUE_REDIS_URL=

# Queue toggles
RENDER_QUEUE_ENABLED=true
PUBLISH_QUEUE_ENABLED=true
CAPTION_QUEUE_ENABLED=true

# Worker concurrency
RENDER_WORKER_CONCURRENCY=1
PUBLISH_WORKER_CONCURRENCY=2
CAPTION_WORKER_CONCURRENCY=1

# Optional secret for internal queue health route
RENDER_WORKER_SECRET=

# ------------------------------------------------------------
# Realtime / event bus Redis routing (optional overrides)
# ------------------------------------------------------------
SOCKET_IO_REDIS_URL=
REALTIME_REDIS_URL=
EVENT_BUS_REDIS_URL=

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
# local (default) | s3
STORAGE_DRIVER=local

# Used by local driver
STORAGE_BASE_DIR=./data

# S3/MinIO storage adapter (used when STORAGE_DRIVER=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PREFIX=
STORAGE_S3_PUBLIC_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_SESSION_TOKEN=

# ------------------------------------------------------------
# Render backend selection
# ------------------------------------------------------------
# local (default) | lambda
RENDER_BACKEND=local

# Optional explicit asset origin used by render paths
RENDER_ASSET_BASE_URL=

# ------------------------------------------------------------
# Remotion Lambda backend (direct @remotion/lambda-client mode)
# ------------------------------------------------------------
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_REGION=
REMOTION_LAMBDA_SERVE_URL=

# Optional lambda tuning
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_POLL_MS=3000
REMOTION_LAMBDA_TIMEOUT_MS=3600000

# Optional lambda dispatch fallback endpoint
# Used when direct lambda variables above are not set.
RENDER_LAMBDA_DISPATCH_URL=

# ------------------------------------------------------------
# Captions / transcription
# ------------------------------------------------------------
# openai | local
CAPTION_BACKEND=openai
# Automatically enqueue caption generation when creating content
CAPTION_AUTO_ON_UPLOAD=false
# OpenAI backend settings (required when CAPTION_BACKEND=openai)
OPENAI_API_KEY=
CAPTION_OPENAI_MODEL=whisper-1

# Local backend settings (used when CAPTION_BACKEND=local)
# whisper.cpp version tag to install (cached locally)
CAPTION_LOCAL_WHISPER_CPP_VERSION=1.7.6
# Whisper model: tiny | tiny.en | base | base.en | small | small.en | medium | medium.en | large-v1 | large-v2 | large-v3 | large-v3-turbo
# Quality-first default (heavier CPU/GPU usage, better transcript accuracy)
CAPTION_LOCAL_WHISPER_MODEL=large-v3
# Decoding strategy for whisper-cli:
# - beam (recommended quality)
# - greedy (faster, lower quality)
CAPTION_LOCAL_WHISPER_DECODE_STRATEGY=beam
# Beam width when CAPTION_LOCAL_WHISPER_DECODE_STRATEGY=beam
CAPTION_LOCAL_WHISPER_BEAM_SIZE=8
# Install/cache paths (absolute or project-relative)
CAPTION_LOCAL_WHISPER_PATH=cache/whisper-cpp
CAPTION_LOCAL_WHISPER_MODEL_PATH=cache/whisper-models
# Print whisper install/transcribe output
CAPTION_LOCAL_WHISPER_VERBOSE=false
# Enable flash-attention if supported by local whisper.cpp build
CAPTION_LOCAL_WHISPER_FLASH_ATTENTION=false
# Optional extra whisper CLI args (JSON string array or whitespace-delimited)
# Example JSON: ["--beam-size","5","--temperature","0"]
CAPTION_LOCAL_WHISPER_ADDITIONAL_ARGS=

# ------------------------------------------------------------
# Local Remotion render tuning
# ------------------------------------------------------------
# Optional integer or percent string (example: "6" or "70%")
# Used as a total concurrency budget in multi-render mode.
REMOTION_RENDER_CONCURRENCY=70%

# Optional integer, controls offthread video decoding workers
REMOTION_OFFTHREAD_VIDEO_THREADS=4

# Optional browser executable overrides
REMOTION_RENDER_BROWSER_EXECUTABLE=
REMOTION_BROWSER_EXECUTABLE=

# chrome-for-testing (default) | headless-shell
REMOTION_RENDER_CHROME_MODE=chrome-for-testing

# Optional ffmpeg path override for mux/concat operations
REMOTION_FFMPEG_PATH=

# Log ffmpeg invocations in render pipeline
REMOTION_LOG_FFMPEG=false

# Enable non-headless debug mode for render browser (local debugging)
REMOTION_RENDER_DEBUG_NON_HEADLESS=false

# ------------------------------------------------------------
# Multi-render tuning (advanced local render strategy)
# ------------------------------------------------------------
REMOTION_MULTI_RENDER=false
# Optional integer: browser instances/chunks to process in parallel
REMOTION_MULTI_RENDER_INSTANCES=6
# Optional integer: frames per chunk
REMOTION_MULTI_RENDER_CHUNK_SIZE=120
# Optional integer: per-chunk Remotion concurrency
REMOTION_MULTI_RENDER_PER_BROWSER_CONCURRENCY=2

# ------------------------------------------------------------
# Shader/headless GL options
# ------------------------------------------------------------
REMOTION_RENDER_ENABLE_SHADER=false

# Optional GL backend when shader rendering is enabled:
# angle | egl | swiftshader | swangle
REMOTION_RENDER_GL=

# Shader debug mode:
# none | passthrough | uv | solid
REMOTION_RENDER_SHADER_DEBUG_MODE=none

# ------------------------------------------------------------
# Render/publish state recovery and stores
# ------------------------------------------------------------
# Marks rendering content failed if stale beyond threshold (ms)
RENDER_STALE_TIMEOUT_MS=120000

# Marks queued/publishing publishes failed if stale beyond threshold (ms)
PUBLISH_STALE_TIMEOUT_MS=180000

# Render progress snapshot store:
# memory | redis (redis auto-used in prod when REDIS_URL exists)
RENDER_PROGRESS_STORE=memory

# Notification live snapshot store:
# memory | redis (redis auto-used when REALTIME_REDIS_URL/REDIS_URL exists)
NOTIFICATIONS_LIVE_STORE=memory

# Notification persistence tuning
# Flush interval for batched DB upserts
NOTIFICATIONS_PERSIST_FLUSH_MS=1000
# Minimum interval between DB writes for same notification key
NOTIFICATIONS_PERSIST_THROTTLE_MS=3000
# Persist progress when crossing each step (0.01 - 0.25)
NOTIFICATIONS_PERSIST_PROGRESS_STEP=0.05
# Max notifications upserted per flush chunk
NOTIFICATIONS_PERSIST_BATCH_SIZE=200

# ------------------------------------------------------------
# Asset API cache tuning
# ------------------------------------------------------------
ASSET_MEMORY_CACHE_MAX_MB=128
ASSET_METADATA_CACHE_TTL_MS=5000

# ------------------------------------------------------------
# Runtime/debug simulation flags (optional)
# ------------------------------------------------------------
MOCK_FAN_SPEED=false
RENDER_SIMULATE=false
RENDER_SIMULATE_ID=demo-render

# ------------------------------------------------------------
# Platform/runtime helpers (optional)
# ------------------------------------------------------------
# Used by auth email URL resolver in hosted environments
VERCEL_URL=
