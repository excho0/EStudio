# Host-side variables read by Docker Compose.
# Copy this file to .env and set POSTGRES_PASSWORD before starting the stack.
POSTGRES_DB=estudio
POSTGRES_USER=estudio
POSTGRES_PASSWORD=

# Local-only host bindings by default.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=6379
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=3000

# Local app URL and Traefik settings. Change these for a reverse-proxy install.
ESTUDIO_PUBLIC_URL=http://localhost:3000
ESTUDIO_HOST=localhost
ESTUDIO_PROXY_NETWORK=estudio-proxy
ESTUDIO_PROXY_NETWORK_EXTERNAL=false
ESTUDIO_TRAEFIK_CERT_RESOLVER=letsencrypt
