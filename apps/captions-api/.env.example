# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010
LOG_LEVEL=info

# Backend selection for transcriber implementation
CAPTIONS_BACKEND=whisperx

# WhisperX defaults
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_MODEL=large-v3
WHISPERX_BATCH_SIZE=16
WHISPERX_LANGUAGE=

# Optional HF token for diarization/alignment models
HF_TOKEN=
