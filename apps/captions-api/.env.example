# ------------------------------------------------------------
# EStudio Captions API
# ------------------------------------------------------------
# Stateless WhisperX transcription service.
# Persistence and orchestration stay in apps/web.

# ------------------------------------------------------------
# Runtime / server
# ------------------------------------------------------------
# development | production | test
APP_ENV=development

# Bind host/port for uvicorn
APP_HOST=0.0.0.0
APP_PORT=8010

# trace | debug | info | warning | error | critical
LOG_LEVEL=info

# Maximum accepted uploaded audio size (MB)
TRANSCRIPTION_MAX_UPLOAD_MB=100

# ------------------------------------------------------------
# Backend selection
# ------------------------------------------------------------
# whisperx | music-faster-whisper
CAPTIONS_BACKEND=whisperx
# Optional bearer token expected on /v1/* routes.
# Leave empty to keep API open.
CAPTION_REMOTE_TOKEN=

# ------------------------------------------------------------
# WhisperX core model settings
# ------------------------------------------------------------
# Device:
# - cuda (recommended when NVIDIA GPU is available)
# - cpu
WHISPERX_DEVICE=cuda

# Compute type:
# - float16 (recommended for modern NVIDIA GPUs)
# - float32 (safer fallback)
# - int8 (lower memory / potentially lower quality)
WHISPERX_COMPUTE_TYPE=float16

# ASR model:
# tiny | base | small | medium | large-v1 | large-v2 | large-v3
# large-v3 gives best quality with higher latency/cost.
WHISPERX_MODEL=large-v3

# Batch size for WhisperX inference.
# Raise for throughput, lower if VRAM is constrained.
WHISPERX_BATCH_SIZE=16

# Optional fixed language code (example: en, ar, es).
# Empty value means auto language detection.
WHISPERX_LANGUAGE=

# VAD backend:
# - none (recommended default for music/lyrics; full-track chunking, no speech gating)
# - silero (speech detector, may drop sung/low-energy lyric sections)
# - pyannote (stricter speech segmentation)
WHISPERX_VAD_METHOD=none

# Optional cache dir for WhisperX / model artifacts.
# Leave empty to use tool defaults.
WHISPERX_CACHE_DIR=

# Enable TF32 matmul/cuDNN on NVIDIA Ampere+ for more throughput.
# true | false
WHISPERX_TF32=false

# Global vocal separation preprocessing (applies to any captions backend).
# When true, captions-api extracts vocals before transcription.
CAPTIONS_USE_VOCAL_SEPARATION=false
# When true, fail request if Demucs separation fails.
# When false, fall back to original normalized audio.
CAPTIONS_VOCAL_SEPARATION_REQUIRED=false
# Demucs model name (example: htdemucs, htdemucs_ft)
CAPTIONS_DEMUCS_MODEL=htdemucs

# ------------------------------------------------------------
# Music faster-whisper backend (CAPTIONS_BACKEND=music-faster-whisper)
# ------------------------------------------------------------
# Model:
# tiny | base | small | medium | large-v2 | large-v3
MUSIC_WHISPER_MODEL=large-v3
# Device:
# - cuda
# - cpu
MUSIC_WHISPER_DEVICE=cuda
# Compute:
# - float16 | float32 | int8
MUSIC_WHISPER_COMPUTE_TYPE=float16
# Higher beam/best_of improve quality at extra latency.
MUSIC_WHISPER_BEAM_SIZE=7
MUSIC_WHISPER_BEST_OF=7
# Optional fixed language for music backend.
MUSIC_WHISPER_LANGUAGE=

# ------------------------------------------------------------
# Diarization (speaker separation)
# ------------------------------------------------------------
# Hugging Face model id used by WhisperX diarization pipeline.
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Required when diarization or gated HF models are used.
HF_TOKEN=
