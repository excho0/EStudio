{
  "name": "estudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "runtime": "tsx src/runtime/runner.ts",
    "runtime:prod": "NODE_ENV=production tsx src/runtime/runner.ts",
    "dev": "pnpm run runtime -- --mode=api+worker",
    "dev:api": "pnpm run runtime -- --mode=api",
    "dev:worker": "pnpm run runtime -- --mode=worker",
    "build": "next build",
    "start": "pnpm run runtime:prod -- --mode=api",
    "start:worker": "pnpm run runtime:prod -- --mode=worker",
    "start:all": "pnpm run runtime:prod -- --mode=api+worker",
    "lint": "eslint",
    "email:dev": "node scripts/run-email-dev.mjs",
    "remotion": "remotion studio",
    "remotion:render": "remotion render",
    "drizzle:dev:generate": "drizzle-kit generate --config=drizzle/dev/drizzle.config.ts",
    "drizzle:dev:migrate": "drizzle-kit migrate --config=drizzle/dev/drizzle.config.ts",
    "drizzle:dev:push": "drizzle-kit push --config=drizzle/dev/drizzle.config.ts",
    "drizzle:dev:studio": "drizzle-kit studio --config=drizzle/dev/drizzle.config.ts",
    "drizzle:dev:introspect": "drizzle-kit introspect --config=drizzle/dev/drizzle.config.ts",
    "drizzle:prod:generate": "drizzle-kit generate --config=drizzle/prod/drizzle.config.ts",
    "drizzle:prod:migrate": "drizzle-kit migrate --config=drizzle/prod/drizzle.config.ts",
    "drizzle:prod:push": "drizzle-kit push --config=drizzle/prod/drizzle.config.ts",
    "drizzle:prod:studio": "drizzle-kit studio --config=drizzle/prod/drizzle.config.ts",
    "drizzle:prod:introspect": "drizzle-kit introspect --config=drizzle/prod/drizzle.config.ts",
    "seed:content": "pnpm dlx tsx -r tsconfig-paths/register scripts/seed-content.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@aws-sdk/client-s3": "^3.989.0",
    "@estudio/audio-core": "workspace:*",
