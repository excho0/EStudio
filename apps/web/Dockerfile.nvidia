FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# Install Node.js 20 + build/runtime dependencies needed by the web/worker runtime,
# including toolchain required for local whisper.cpp CUDA builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  gnupg \
  git \
  cmake \
  make \
  g++ \
  pkg-config \
  python3 \
  sqlite3 \
  libsqlite3-dev \
  ffmpeg \
  libnss3 \
  libnspr4 \
  libatk1.0-0 \
  libatk-bridge2.0-0 \
  libcups2 \
  libdrm2 \
  libxkbcommon0 \
  libxcomposite1 \
  libxdamage1 \
  libxfixes3 \
  libxrandr2 \
  libgbm1 \
  libasound2t64 \
  libatspi2.0-0 \
  libx11-xcb1 \
  libxshmfence1 \
  libgtk-3-0 \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

FROM base AS deps
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/audio-core/package.json ./packages/audio-core/package.json
COPY packages/utils/package.json ./packages/utils/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
WORKDIR /app

COPY . .
RUN pnpm build

FROM base AS runtime
WORKDIR /app

RUN mkdir -p /etc/apt/keyrings   && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub     | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg   && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main"     > /etc/apt/sources.list.d/google-chrome.list   && apt-get update && apt-get install -y --no-install-recommends     google-chrome-stable     libvulkan1     mesa-vulkan-drivers     libegl1     libgles2     libgl1     xvfb     dbus-x11   && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# NVIDIA Container Toolkit variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display

RUN cat <<'EOF' >/usr/local/bin/chromium-headless-angle
#!/usr/bin/env bash
set -e

# Dynamically resolve NVIDIA/CDI Nix store paths if they exist
NVIDIA_SHARE_DIR="$(find /nix/store -maxdepth 2 -name "*nvidia-x11*" -type d -path "*/share" | head -n 1)"
if [ -n "$NVIDIA_SHARE_DIR" ]; then
  export __EGL_VENDOR_LIBRARY_DIRS="$NVIDIA_SHARE_DIR/glvnd/egl_vendor.d"
  export VK_ICD_FILENAMES="$NVIDIA_SHARE_DIR/vulkan/icd.d/nvidia_icd.x86_64.json"
  # Some drivers also need the lib dir in LD_LIBRARY_PATH
  NVIDIA_LIB_DIR="${NVIDIA_SHARE_DIR%/share}/lib"
  if [ -d "$NVIDIA_LIB_DIR" ]; then
    export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$NVIDIA_LIB_DIR"
  fi
fi

BROWSER_BIN="$(command -v google-chrome-stable || command -v google-chrome || command -v chromium || command -v chromium-browser)"
exec xvfb-run -a -s "-screen 0 1920x1080x24" "$BROWSER_BIN" \
  --headless \
  --no-sandbox \
  --disable-setuid-sandbox \
  --use-gl=angle \
  --ignore-gpu-blocklist \
  --enable-webgl \
  --disable-gpu-sandbox \
  "$@"
EOF
RUN chmod +x /usr/local/bin/chromium-headless-angle
# Root workspace metadata + installed deps
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules

# Built web workspace
COPY --from=build /app/apps/web ./apps/web
COPY --from=build /app/packages ./packages

EXPOSE 3000

CMD ["pnpm", "start"]
